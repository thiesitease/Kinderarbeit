.vscode/

# Schlüssel und Zugangsdaten gehören niemals ins Repository.
# Das fängt auch den Fall ab, dass ssh-keygen versehentlich hier statt im
# Benutzerverzeichnis landet – unter Windows löst PowerShell die Tilde nicht
# auf und legt dann ein Verzeichnis namens "~" an.
.ssh/
~/
id_rsa*
id_ecdsa*
id_ed25519*
*_deploy
*_deploy.pub
*.pem
*.ppk
